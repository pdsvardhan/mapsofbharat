    "check:css": "node scripts/check-globals-layers.mjs",
    "check:specs": "node scripts/check-spec-imports.mjs",
    "check:centroids": "node scripts/check-centroids.mjs",
    "geo:paths": "node scripts/build-family-paths.mjs",
    "prebuild": "node scripts/check-raw-assets.mjs && node scripts/check-globals-layers.mjs && node scripts/check-centroids.mjs && node scripts/build-family-paths.mjs --check",
    "postbuild": "node scripts/check-raw-assets.mjs --output"
