# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/data
*.db
.env
pipeline/.venv/
pipeline/raw/
*.log
pipeline/shrug/
*.bak

# python
__pycache__/
*.pyc
pipeline/raw-new/
test-results/

# Writable runtime store (corrections.db + error-sink log). Owned by the
# container uid; never committed. See docker-compose.yml and to-do #441.
/data-rw

# Derived brotli variants of the geometry (#405-F). Regenerated by prebuild via
# scripts/build-geo-compressed.mjs; committing them would be committing a build output
# that can silently disagree with the .geojson it came from.
public/geo/*.br
public/geo/*.gz
